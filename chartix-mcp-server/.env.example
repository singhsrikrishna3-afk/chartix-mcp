# Names only. Never commit a value.

# Where the Chartix API lives. Production is https://api.chartixai.com
CHARTIX_BASE_URL=

# Credential. Chartix issues no API keys today — this is a login JWT from
# POST /api/auth/login, and it expires (7 days unless the deployment sets
# ACCESS_TOKEN_EXPIRE_MINUTES). See README "Credentials" for why that matters
# and what a hosted deployment needs instead.
CHARTIX_TOKEN=

# Rate limiting. Chartix publishes no limits and enforces none, so these exist
# to protect a 1-OCPU box from us, not to satisfy a documented quota.
CHARTIX_RPM=60
CHARTIX_CONCURRENCY=4

# Streamable HTTP listener. Bind to loopback unless you have read the README's
# "Hosting" section, because this process holds a credential.
PORT=8420
HOST=127.0.0.1
